{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx"
  },
  "include": ["src/**/*", "lib/**/*", "api/**/*", "tests/**/*", "*.js"],
  "exclude": ["dist", "node_modules", "tests/fixtures"]
}
