{
  "name": "flowinternals-seclens-app",
  "version": "1.0.0",
  "description": "SecLens - On-demand security analysis for GitHub repositories",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server.js",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:api\"",
    "build": "vite build",
    "lint": "eslint .",
    "type": "tsc --noEmit -p tsconfig.typecheck.json",
    "preview": "vite preview",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "secrets:scan": "node scripts/gitleaks-ci.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "self-scan": "node scripts/self-scan-local.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowinternals/seclens-app.git"
  },
  "keywords": [
    "security",
    "github",
    "analysis",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/flowinternals/seclens-app/issues"
  },
  "homepage": "https://github.com/flowinternals/seclens-app#readme",
  "dependencies": {
    "cors": "^2.8.5",
    "dompurify": "^3.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "openai": "^6.7.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^6.0.3",
    "vite": "^7.1.12",
    "vitest": "^4.1.5"
  }
}
